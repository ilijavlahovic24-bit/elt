# airflow/Dockerfile
# Build context: project root
FROM apache/airflow:2.10.4

# Pin dbt + duckdb to match host venv, plus pandas/pyarrow needed by ingestion.
# Why pin: DuckDB storage format is forward-incompatible, and dbt-duckdb
# 1.11.0 is tested with duckdb 1.x line.
RUN pip install --no-cache-dir \
    "duckdb==1.5.6" \
    "dbt-duckdb==1.11.0" \
    "pandas>=2.0" \
    "pyarrow>=14.0"

# Copy project files into the image, owned by airflow user (UID 50000).
# COPY (not bind mount) avoids UID/GID mismatch on Windows Docker Desktop.
# data/raw and data/warehouse are NOT copied - they're generated by the pipeline.
USER root
COPY --chown=airflow:root ./ingestion   /opt/airflow/project/ingestion
COPY --chown=airflow:root ./warehouse   /opt/airflow/project/warehouse
COPY --chown=airflow:root ./dbt         /opt/airflow/project/dbt
COPY --chown=airflow:root ./scripts     /opt/airflow/project/scripts
COPY --chown=airflow:root ./data/source /opt/airflow/project/data/source
COPY --chown=airflow:root ./airflow/dags /opt/airflow/dags
RUN mkdir -p /opt/airflow/project/data/raw /opt/airflow/project/data/warehouse && \
    chown -R airflow:root /opt/airflow/project/data
USER airflow