at": "2026-10-23T19:02:08.326953Z", "completed_at": "2026-10-23T19:02:08.371285Z"}, {"name": "execute", "started_at": "2026-10-23T19:02:08.371663Z", "completed_at": "2026-10-23T19:02:08.551763Z"}], "thread_id": "Thread-2 (worker)", "execution_time": 0.22945618629455566, "adapter_response": {"_message": "OK"}, "message": "OK", "failures": null, "unique_id": "model.retail_elt.dim_customer", "compiled": true, "compiled_code": "-- dbt/models/marts/dim_customer.sql\n-- One row per customer. Our source only carries customer_id + region,\n-- so that's all we can populate - but the shape is correct for the star schema.\n-- In production this would join a customers table for name/address/etc.\n\nwith customers as (\n    select distinct\n        customer_id,\n        region   -- one \"home region\" per customer in our data\n    from \"retail\".\"main_staging\".\"stg_orders\"\n),\n\nfinal as (\n    select\n        -- surrogate key: stable across runs (md5 of natural key)\n        md5(cast(customer_id as varchar)) as customer_sk,\n        customer_id,\n        region\n    from customers\n)\n\nselect * from final", "relation_name": "\"retail\".\"main_marts\".\"dim_customer\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-10-23T19:02:08.321339Z", "completed_at": "2026-10-23T19:02:08.328431Z"}, {"name": "execute", "started_at": "2026-10-23T19:02:08.328797Z", "completed_at": "2026-10-23T19:02:08.555936Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.23604464530944824, "adapter_response": {"_message": "OK"}, "message": "OK", "failures": null, "unique_id": "model.retail_elt.dim_date", "compiled": true, "compiled_code": "-- dbt/models/marts/dim_date.sql\n-- One row per calendar date in the range covered by orders.\n-- Why: GROUP BY order_date skips days with zero orders; a date spine fills gaps.\n-- Also: pre-computed year/month/quarter attributes so BI tools don't recalculate.\n\nwith date_bounds as (\n    select\n        min(order_date) as min_date,\n        max(order_date) as max_date\n    from \"retail\".\"main_staging\".\"stg_orders\"\n),\n\ndate_spine as (\n    -- DuckDB: generate_series over dates\n    select\n        cast(unnest(generate_series(min_date, max_date, interval 1 day)) as date) as date_day\n    from date_bounds\n),\n\nfinal as (\n    select\n        -- surrogate key: deterministic hash of the natural key (date)\n        md5(cast(date_day as varchar)) as date_sk,\n        date_day,\n        extract(year    from date_day) as year,\n        extract(quarter from date_day) as quarter,\n        extract(month   from date_day) as month,\n        strftime(date_day, '%B')       as month_name,\n        extract(day     from date_day) as day_of_month,\n        extract(dow     from date_day) as day_of_week,   -- 0=Sunday..6=Saturday\n        case when extract(dow from date_day) in (0, 6) then true else false end as is_weekend\n    from date_spine\n)\n\nselect * from final", "relation_name": "\"retail\".\"main_marts\".\"dim_date\"", "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-10-23T19:02:08.561277Z", "completed_at": "2026-10-23T19:02:08.581424Z"}, {"name": "execute", "started_at": "2026-10-23T19:02:08.582004Z", "completed_at": "2026-10-23T19:02:08.605909Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 0.04886484146118164, "adapter_response": {"_message": "OK"}, "message": null, "failures": 0, "unique_id": "test.retail_elt.not_null_dim_product_product_sk.271feb5417", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect product_sk\nfrom \"retail\".\"main_marts\".\"dim_product\"\nwhere product_sk is null\n\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-10-23T19:02:08.567478Z", "completed_at": "2026-10-23T19:02:08.583658Z"}, {"name": "execute", "started_at": "2026